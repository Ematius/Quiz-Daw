  {
    "id": "UT4-Q07",
    "tema": "UT4: Configuración de sistemas operativos",
    "pregunta": "¿Qué significa que la contraseña de un usuario aparezca como “!” en /etc/shadow?",
    "contexto": "Diagnóstico de bloqueo de cuenta.",
    "tipo": "single",
    "opciones": [
      { "clave": "a", "texto": "La cuenta está bloqueada" },
      { "clave": "b", "texto": "El usuario es root" },
      { "clave": "c", "texto": "El usuario pertenece a varios grupos" },
      { "clave": "d", "texto": "La contraseña nunca caduca" }
    ],
    "respuesta_correcta": ["a"],
    "explicacion": {
      "temario": "Un `!` delante del hash indica cuenta bloqueada (no login por contraseña).",
      "analisis_incorrectas": [
        { "clave": "b", "motivo": "Root no se identifica por `!`." },
        { "clave": "c", "motivo": "Grupos se gestionan en `/etc/group`." },
        {
          "clave": "d",
          "motivo": "Caducidad se controla por días máximos, no por `!`."
        }
      ],
      "resumen_didactico": "`!`/`!!` → bloqueada.",
      "ejemplo_practico": "sudo passwd -l usuario1",
      "conclusion_final": "“!” en shadow = cuenta bloqueada."
    }
  },
