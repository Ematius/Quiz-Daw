[
  {
    "id": "UT4-Q01",
    "tema": "UT4: Configuración de sistemas operativos",
    "pregunta": "En una asesoría de Sevilla, un nuevo empleado necesita una cuenta en Linux. Quieren que acceda con su propio directorio personal. ¿Qué comando usarías?",
    "contexto": "Alta de usuario con carpeta home propia.",
    "tipo": "single",
    "opciones": [
      { "clave": "a", "texto": "useradd -m empleado1" },
      { "clave": "b", "texto": "groupadd empleado1" },
      { "clave": "c", "texto": "passwd empleado1" },
      { "clave": "d", "texto": "chmod 755 /home/empleado1" }
    ],
    "respuesta_correcta": ["a"],
    "explicacion": {
      "temario": "`useradd -m` crea el usuario y su directorio personal copiando los archivos de `/etc/skel`.",
      "analisis_incorrectas": [
        { "clave": "b", "motivo": "Crea grupos, no usuarios." },
        {
          "clave": "c",
          "motivo": "Solo establece la contraseña a un usuario ya existente."
        },
        {
          "clave": "d",
          "motivo": "Cambia permisos, no crea usuarios ni homes."
        }
      ],
      "resumen_didactico": "`useradd` crea usuarios; `-m` asegura el home.",
      "ejemplo_practico": "sudo useradd -m empleado1 && sudo passwd empleado1",
      "conclusion_final": "Para crear usuario con home: `useradd -m <usuario>`."
    }
  },
  {
    "id": "UT4-Q02",
    "tema": "UT4: Configuración de sistemas operativos",
    "pregunta": "¿Qué archivo de Linux contiene la información principal de las cuentas de usuario, como UID y shell asignado?",
    "contexto": "Auditoría de cuentas en un servidor Linux.",
    "tipo": "single",
    "opciones": [
      { "clave": "a", "texto": "/etc/passwd" },
      { "clave": "b", "texto": "/etc/profile" },
      { "clave": "c", "texto": "/etc/shadow" },
      { "clave": "d", "texto": "/etc/skel" }
    ],
    "respuesta_correcta": ["a"],
    "explicacion": {
      "temario": "`/etc/passwd` almacena login, UID, GID, home y shell.",
      "analisis_incorrectas": [
        { "clave": "b", "motivo": "Configura entorno global, no usuarios." },
        { "clave": "c", "motivo": "Guarda contraseñas cifradas y caducidad." },
        { "clave": "d", "motivo": "Plantillas copiadas al home nuevo." }
      ],
      "resumen_didactico": "Usuarios: `/etc/passwd`; contraseñas: `/etc/shadow`.",
      "ejemplo_practico": "grep juan /etc/passwd",
      "conclusion_final": "`/etc/passwd` es la fuente base de datos de cuentas."
    }
  },
  {
    "id": "UT4-Q03",
    "tema": "UT4: Configuración de sistemas operativos",
    "pregunta": "Has creado un usuario en Linux, pero olvidaste asignarle contraseña. ¿Qué comando usarías para establecerla?",
    "contexto": "Post-alta de usuario sin password.",
    "tipo": "single",
    "opciones": [
      { "clave": "a", "texto": "chgrp usuario1" },
      { "clave": "b", "texto": "passwd usuario1" },
      { "clave": "c", "texto": "ls -la /home/usuario1" },
      { "clave": "d", "texto": "chmod 700 usuario1" }
    ],
    "respuesta_correcta": ["b"],
    "explicacion": {
      "temario": "`passwd <usuario>` establece o cambia la contraseña (hash en `/etc/shadow`).",
      "analisis_incorrectas": [
        { "clave": "a", "motivo": "Cambia grupo de archivos, no contraseñas." },
        { "clave": "c", "motivo": "Lista contenidos; no gestiona claves." },
        { "clave": "d", "motivo": "Permisos de archivo, no contraseñas." }
      ],
      "resumen_didactico": "Crear con `useradd`; asegurar con `passwd`.",
      "ejemplo_practico": "sudo passwd usuario1",
      "conclusion_final": "Para poner contraseña usa `passwd`."
    }
  },
  {
    "id": "UT4-Q04",
    "tema": "UT4: Configuración de sistemas operativos",
    "pregunta": "En un hospital de Zaragoza, el administrador debe añadir a un médico al grupo “historiales”. ¿Qué comando ejecuta?",
    "contexto": "Asignación de permisos por grupo.",
