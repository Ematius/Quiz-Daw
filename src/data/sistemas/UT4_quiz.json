      { "clave": "b", "texto": "passwd historiales medico1" },
      { "clave": "c", "texto": "usermod -aG historiales medico1" },
      { "clave": "d", "texto": "groupdel historiales usuario" }
    ],
    "respuesta_correcta": ["c"],
    "explicacion": {
      "temario": "`usermod -aG` agrega grupos secundarios sin perder pertenencias.",
      "analisis_incorrectas": [
        {
          "clave": "a",
          "motivo": "Cambia permisos de archivos, no membresías."
        },
        { "clave": "b", "motivo": "Gestiona contraseñas." },
        { "clave": "d", "motivo": "Eliminaría el grupo, no procede." }
      ],
      "resumen_didactico": "Usuarios ↔ grupos: `usermod -aG`.",
      "ejemplo_practico": "sudo usermod -aG historiales medico1",
      "conclusion_final": "Añade usuarios a grupos con `usermod -aG`."
    }
  },
  {
