        { "clave": "c", "motivo": "Cambia propietario/grupo, no permisos." }
      ],
      "resumen_didactico": "Permisos numéricos: 7=rwx, 6=rw.",
      "ejemplo_practico": "sudo chown jefe:equipo proyectos && sudo chmod 770 proyectos",
